# ─────────────────────────────────────────────────────────────────────────────
# ABA Shield — environment variable template
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and public anon key (safe to expose in the browser bundle).
# Supabase dashboard → Project Settings → API. Only the anon key belongs here —
# never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same project URL, unprefixed — read server-side by api/*.js functions
# (Vite only injects VITE_-prefixed vars into the browser bundle).
SUPABASE_URL=

# Service-role key. Server-side only, NEVER exposed to the browser bundle —
# used by api/check-auth-expiry.js (ACD-70) for cross-user DB reads the anon
# key can't do. Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# invoking api/check-auth-expiry.js — set the same value in the Vercel env var
# and Vercel wires it up automatically. Any random string works.
CRON_SECRET=

# ── DEMO MODE ────────────────────────────────────────────────────────────────
# true  → hardcoded demo drafts, no AI calls, zero cost (default for dev/demo)
# false → real Claude AI draft generation (requires ANTHROPIC_API_KEY below)
VITE_DEMO_MODE=true

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Required only when VITE_DEMO_MODE=false.
# Server-side only — key is never exposed to the browser bundle.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── AssemblyAI Transcription ──────────────────────────────────────────────────
# Required for voice recording → transcript feature.
# https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Frontend DSN. Safe to expose in the browser bundle. Leave empty to disable
# Sentry entirely (dev is always disabled regardless of this value).
# Sentry dashboard → Project Settings → Client Keys (DSN).
VITE_SENTRY_DSN=

# ── Dev flags ────────────────────────────────────────────────────────────────
# true  → mock transcript (instant, free)   false → real AssemblyAI call
DEV_MOCK_TRANSCRIPTION=true
MAX_TRANSCRIPTION_MINUTES=5
